# Petal worker (BullMQ process) — multi-stage build for Railway.
# Built from the repo root: docker build -f Dockerfile.worker .

# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# corepack picks the pnpm version pinned in package.json#packageManager
RUN corepack enable

# ---- fetch: warm the pnpm store from the lockfile alone, so dependency layers
# cache independently of source changes.
FROM base AS fetch
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# ---- install: offline install across the workspace.
FROM fetch AS build
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --offline

# ---- run: worker process as the non-root `node` user.
# tsx is already a dependency of @petal/worker — run the source directly.
FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /repo ./
USER node
CMD ["pnpm", "--filter", "@petal/worker", "start"]
